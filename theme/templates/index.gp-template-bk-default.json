    "gp_shopify_original_section_596120970972890086": {
      "settings": {
        "checksum": "",
        "gg0iYQGaH9W_text": "<p><span style=\"background-color:rgba(245,245,245,0);color:#000000;font-size:15px;\">Fades are the hardest part of a haircut. GLYDE is built to handle them with ease. As you move the clipper, built-in sensors track your motion and angle, shifting the blade automatically to keep the fade smooth and consistent. The fade-band locks in the starting point, showing exactly where the fade should begin.</span></p>",
        "ggwmgHL2nKw_text": "Fades Made&nbsp;<span style=\"background-color:#E43C2F;\"> </span><span style=\"background-color:#E43C2F;color:#FFFFFF;\">Simple</span><span style=\"background-color:#E43C2F;\">&nbsp;</span>"
      },
      "type": "gp-section-596120970972890086"
    },
    "gp_shopify_original_section_596122260671038054": {
      "settings": {
        "checksum": "",
        "gg3js6cMmxR_text": "<i><strong>GLYDE Adapts As You Cut</strong></i>",
        "ggBGFMR8pHs_text": "Designed to Be&nbsp;<br><span style=\"background-color:#E43C2F;\">&nbsp;</span><span style=\"background-color:#E43C2F;color:#FFFFFF;\">Mistake-Proof</span><span style=\"background-color:#E43C2F;\">&nbsp;</span>",
        "ggw2NqDe4Lw_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(34,34,34);font-size:16px;\">The smart blade senses your speed, tilt, and angle, and adjusts in real time to prevent uneven fades or overcuts. Move too fast and the blade retracts. Tilt the wrong way and it trims less. GLYDE is here to keep you steady and confident!</span></p>"
      },
      "type": "gp-section-596122260671038054"
    },
    "gp_shopify_original_section_596124686539031070": {
      "settings": {
        "checksum": "",
        "gg90aa-FpGH_text": "<p><span style=\"font-size:15px;\">GLYDE’s app comes with a library of popular cuts, tested across different head shapes and hair types. Simply choose the one that suits you best and follow step-by-step guidance, all from your phone.</span></p><p>&nbsp;</p><p><span style=\"font-size:15px;\">And soon, you’ll be able to browse styles from the GLYDE community, share your own templates, and get inspired by real cuts from real users.</span></p>",
        "ggmbDSw4Ytl_text": "Styles That&nbsp;<span style=\"background-color:#E43C2F;\"> </span><span style=\"background-color:#E43C2F;color:#FFFFFF;\">Fit You</span><span style=\"background-color:#E43C2F;\">&nbsp;</span>"
      },
      "type": "gp-section-596124686539031070"
    },
    "gp_shopify_original_section_596125375260525086": {
      "settings": {
        "checksum": "",
        "ggesCMxGAN2_text": "<p><span style=\"background-color:rgb(245,245,245);color:rgb(34,34,34);font-size:15px;\">GLYDE fits into your life, saving you the hassle of waiting, traveling, and booking ahead. In just 10 minutes, your hair is sharp and fresh again—at home or wherever you are. Quick, easy, and reliable whenever you need it.</span></p>",
        "ggvSKggVVed_text": "A Fresh Cut in&nbsp;<span style=\"background-color:#E43C2F;\"> </span><span style=\"background-color:#E43C2F;color:#FFFFFF;\">10 Minutes</span><span style=\"background-color:#E43C2F;\">&nbsp;</span><span style=\"background-color:rgba(245,245,245,0.77);\"> </span>—<br>&nbsp;Anytime, Anywhere"
      },
      "type": "gp-section-596125375260525086"
    },
    "gp_shopify_original_section_596125375260590622": {
      "settings": {
        "checksum": "",
        "gg7RaHuM6n6_text": "One-Time Investment,&nbsp;<br><span style=\"background-color:#E43C2F;\">&nbsp;</span><span style=\"background-color:#E43C2F;color:#FFFFFF;\">Long-Term Savings</span><span style=\"background-color:#E43C2F;\">&nbsp;</span>",
        "ggDdRm2VJXn_text": "<p><span style=\"font-size:15px;\">Skip the endless barber trips and the money that disappears with every visit.&nbsp;</span><br><span style=\"font-size:15px;\">&nbsp;</span></p><p><span style=\"font-size:15px;\">Think about it: booking an appointment, waiting in line, driving there and back — that’s over an hour gone for every haircut. Add the $30+ cost, and the true price stacks up fast.</span><br><span style=\"font-size:15px;\">&nbsp;</span></p><p><span style=\"font-size:15px;\">With GLYDE, you invest once and gain the freedom to cut anywhere, anytime.</span></p>",
        "ggGBgF7_QzD_text": "<i><strong>Stop Overpaying For Haircut</strong></i>"
      },
      "type": "gp-section-596125375260590622"
    },
