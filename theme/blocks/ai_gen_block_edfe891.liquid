    },
    {
      "type": "header",
      "content": "Bottom heading"
    },
    {
      "type": "text",
      "id": "bottom_heading",
      "label": "Heading",
      "default": "When it comes to home haircuts…"
    },
    {
      "type": "range",
      "id": "bottom_heading_size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Desktop font size",
      "default": 32
    },
    {
      "type": "range",
      "id": "bottom_heading_size_mobile",
