{%- liquid
  comment
    This path is intentionally fixed. Theme settings must not be able to route
    a reservation to the retired $3 product or an untrusted external checkout.
  endcomment
  assign reserve_url = '/pages/deposit'
-%}

<div id="top" class="page" data-glyde-landing data-glyde-version="3">
  <section class="heroV2" aria-labelledby="hero-title">
    <div class="heroV2Media" aria-hidden="true">
      <img
        class="heroV2Poster"
        src="{{ 'media-hero-poster.jpg' | asset_url }}"
        alt=""
        width="1920"
        height="1080"
        fetchpriority="high"
      >
      <img
        class="heroV2MobilePoster"
        src="{{ 'v3-hero-mobile-figma.png' | asset_url }}"
        alt=""
        width="1080"
        height="1308"
        fetchpriority="high"
      >
      <video
        class="heroV2Video"
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        poster="{{ 'media-hero-poster.jpg' | asset_url }}"
        data-glyde-hero-video
      >
        <source src="{{ 'media-hero.mp4' | asset_url }}" type="video/mp4">
        <source src="{{ 'media-hero.webm' | asset_url }}" type="video/webm">
      </video>
    </div>
    <div class="heroV2Scrim" aria-hidden="true"></div>

    <div class="heroV2Inner">
      <header class="heroV2Header">
        <a href="#top" aria-label="GLYDE home">
          <img
            class="heroV2Logo"
            src="{{ 'hero-logo-wordmark.png' | asset_url }}"
            width="1196"
            height="204"
            alt="GLYDE"
            loading="eager"
          >
        </a>
        <a class="heroV2Reserve" href="{{ reserve_url | escape }}" data-glyde-reserve-link>Reserve For $5</a>
      </header>

      <div class="heroV2Copy">
        <h1 id="hero-title" class="heroV2Title">
          <span>Your first</span>
          <span class="heroV2TitleAccent">perfect fade</span>
          <span>at home</span>
        </h1>
        <p class="heroV2Lead">
          The first clipper with auto-fade technology. Guided cuts, consistent results, zero skill needed.
        </p>

        <div class="heroV2Form formShell">
          {% render 'glyde-v3-waitlist', waitlist_location: 'hero', waitlist_return_to: reserve_url %}
        </div>
      </div>

      <ul class="heroV2Press" aria-label="Featured in">
        <li style="--press-w: 139.7">
          <a
            href="https://www.dailymail.co.uk/sciencetech/article-15455353/AI-smart-clippers-automatic-haircut.html"
