            <img src="{{ 'press-daily-mail.png' | asset_url }}" alt="Daily Mail" width="417" height="77" loading="eager">
          </a>
        </li>
        <li style="--press-w: 78.7">
          <a
            href="https://uk.finance.yahoo.com/news/ai-hair-clippers-self-opening-170814028.html"
            target="_blank"
            rel="noreferrer"
            aria-label="Yahoo Finance"
          >
            <img src="{{ 'press-yahoo-finance.png' | asset_url }}" alt="Yahoo Finance" width="234" height="87" loading="eager">
          </a>
        </li>
        <li style="--press-w: 128.3">
          <img src="{{ 'press-the-verge.png' | asset_url }}" alt="The Verge" width="383" height="86" loading="eager">
        </li>
        <li style="--press-w: 241.7">
          <a
            href="https://www.euronews.com/next/2026/01/07/from-musical-lollipops-to-ai-hair-clippers-heres-the-weirdest-tech-at-ces-2026-so-far"
