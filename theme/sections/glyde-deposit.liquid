{%- liquid
  assign deposit_product = section.settings.product
  if deposit_product == blank
    assign deposit_product = all_products['reserve-your-special-discount']
  endif
  assign deposit_variant = deposit_product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
  assign deposit_price = '$3'
  if deposit_variant != blank
    assign deposit_price = deposit_variant.price | money_without_trailing_zeros
  endif
  assign contact_email = section.settings.contact_email | default: 'timchen@smarthairclipper.com'

  assign faq_1_question = 'What is the reservation deposit?'
  capture faq_1_answer
    echo 'By leaving a small refundable deposit (typically 1–5% of the product’s price), you secure the right to purchase this product at a special pre-launch discount once it becomes available. Your reservation is fully protected by our refund guarantee until successful delivery.'
  endcapture
  assign faq_2_question = 'When can I get my product?'
  capture faq_2_answer
    echo 'During a Prelaunch, product creators offer you the lowest ever exclusive price when you reserve. This is not yet a full purchase, and it’s up to you to cancel or proceed with the purchase later. Product launch and delivery timelines are somewhat unpredictable. Where possible, creators offer estimates. And if you don’t receive the product within 2 years, you’ll get a full automatic refund.'
  endcapture
  assign faq_3_question = 'How can I claim a refund?'
  capture faq_3_answer
    echo 'Claiming a refund is easy. Just email '
    echo contact_email
    echo ' from the email you used to reserve the discount. Remember to mention which product you’d like to get a refund for. We’ll process it on the same day, no questions asked!'
  endcapture
  assign faq_4_question = 'How can I learn more about GLYDE?'
  capture faq_4_answer
    echo 'For any questions about this product, feel free to reach out to us directly at '
    echo contact_email
    echo '. Our team will be happy to provide more details or assist with your reservation.'
  endcapture
-%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{% if settings.cart_type == 'notification' %}
  <script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
{% endif %}

<div class="glyde-deposit" data-glyde-deposit>
  <div class="glyde-deposit__content">
    <div class="glyde-deposit__purchase-grid">
      <div class="glyde-deposit__intro">
        <p class="glyde-deposit__eyebrow">VIP PRELAUNCH</p>
        <h1>{{ section.settings.heading | default: 'Thanks for subscribing!' | escape }}</h1>
        <p>
          My friend, you can become one of the first deposit backers with
          <strong>exclusive perks.</strong>
        </p>
        <p>
          Reserve your spot for just <strong>{{ deposit_price }}</strong> and you will receive the following perks.
        </p>
      </div>

      <div
        class="glyde-deposit__offer-art"
        role="img"
        aria-label="GLYDE VIP prelaunch offer: $139 discount price, reserve for {{ deposit_price }}, save $80"
      >
        <img
          class="glyde-deposit__offer-image"
          src="{{ 'glyde-deposit-offer.png' | asset_url }}"
          alt=""
          width="928"
          height="656"
          loading="eager"
          fetchpriority="high"
        >
      </div>

      <div class="glyde-deposit__actions">
        {% if deposit_product != blank %}
          <product-form class="glyde-deposit__product-form product-form" data-section-id="{{ section.id }}">
            <div class="glyde-deposit__form-error product-form__error-message-wrapper" role="alert" hidden>
              <span class="svg-wrapper">{{ 'icon-error.svg' | inline_asset_content }}</span>
              <span class="product-form__error-message"></span>
            </div>
            {% form 'product',
              deposit_product,
              id: product_form_id,
              class: 'form',
              novalidate: 'novalidate',
              data-type: 'add-to-cart-form'
            %}
              <input
                class="product-variant-id"
                type="hidden"
                name="id"
                value="{{ deposit_variant.id }}"
                {% unless deposit_variant.available %}disabled{% endunless %}
              >
              <input type="hidden" name="quantity" value="1">
              <button
                id="ProductSubmitButton-{{ section.id }}"
                class="glyde-deposit__reserve-button"
                type="submit"
                name="add"
                {% unless deposit_variant.available %}disabled{% endunless %}
              >
                <span>{% if deposit_variant.available %}Reserve Now{% else %}Sold out{% endif %}</span>
                {% render 'loading-spinner' %}
              </button>
            {% endform %}
          </product-form>
        {% else %}
          <div class="glyde-deposit__product-missing" role="status">
            <strong>Reservation temporarily unavailable</strong>
            <span>Please check back soon.</span>
          </div>
        {% endif %}

        <a
          class="glyde-deposit__decline-button"
          href="{{ section.settings.no_thanks_url | default: 'https://form.typeform.com/to/ujNHomKI' }}"
        >
          No Thanks
        </a>
      </div>
    </div>

    <section class="glyde-deposit__benefits" aria-label="Reservation guarantees">
      <article class="glyde-deposit__benefit-card">
        <span class="glyde-deposit__benefit-icon" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none">
            <circle cx="16" cy="16" r="12.5" stroke="currentColor" stroke-width="2.5"/>
            <path d="M20.8 11.7c-1-1-2.4-1.6-4.1-1.6-2.8 0-4.8 1.5-4.8 3.7 0 2.1 1.7 3.1 4.5 3.6 2 .4 2.7.8 2.7 1.8 0 1.1-1 1.8-2.7 1.8-1.8 0-3.4-.7-4.5-1.9M16.4 7.8v16.4" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/>
          </svg>
        </span>
        <div>
          <h2>100% Money-Back Guarantee</h2>
          <p>Cancel your reservation anytime before our launch and get a full refund.</p>
        </div>
      </article>
      <article class="glyde-deposit__benefit-card">
        <span class="glyde-deposit__benefit-icon" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none">
            <path d="M5 13.5h22v13H5zM8.5 9.5h15v4h-15zM16 7v19M5 17h22" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
            <path d="M16 9c-1.4-3.5-5.8-4.8-6.8-2.1C8.2 9.6 12 11 16 11M16 9c1.4-3.5 5.8-4.8 6.8-2.1C23.8 9.6 20 11 16 11" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
          </svg>
        </span>
        <div>
          <h2>Prelaunch Refund Guarantee</h2>
          <p>Your reservation deposit is safe with us. If you change your mind before the launch or don’t receive the product, you can claim a full refund.</p>
        </div>
      </article>
    </section>

    <section class="glyde-deposit__faq" aria-labelledby="deposit-faq-title">
      <p class="glyde-deposit__eyebrow">FAQ</p>
      <h2 id="deposit-faq-title">How Prelaunch Works</h2>
      <div class="glyde-deposit__faq-list">
        <details>
          <summary><span>{{ faq_1_question }}</span><i aria-hidden="true"></i></summary>
          <div><p>{{ faq_1_answer | strip }}</p></div>
        </details>
        <details>
          <summary><span>{{ faq_2_question }}</span><i aria-hidden="true"></i></summary>
          <div><p>{{ faq_2_answer | strip }}</p></div>
        </details>
        <details>
          <summary><span>{{ faq_3_question }}</span><i aria-hidden="true"></i></summary>
          <div><p>{{ faq_3_answer | strip }}</p></div>
        </details>
        <details>
          <summary><span>{{ faq_4_question }}</span><i aria-hidden="true"></i></summary>
          <div><p>{{ faq_4_answer | strip }}</p></div>
        </details>
      </div>
    </section>
  </div>

</div>

{% if deposit_product != blank %}
  <script type="application/ld+json">{{ deposit_product | structured_data }}</script>
{% endif %}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": {{ faq_1_question | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ faq_1_answer | strip | json }} }
      },
      {
        "@type": "Question",
        "name": {{ faq_2_question | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ faq_2_answer | strip | json }} }
      },
      {
        "@type": "Question",
        "name": {{ faq_3_question | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ faq_3_answer | strip | json }} }
      },
      {
        "@type": "Question",
        "name": {{ faq_4_question | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ faq_4_answer | strip | json }} }
      }
    ]
  }
</script>

{% schema %}
{
  "name": "GLYDE deposit page",
  "class": "glyde-deposit-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Reservation product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "url",
      "id": "no_thanks_url",
      "label": "No Thanks destination"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Refund and support email",
      "default": "timchen@smarthairclipper.com"
    }
  ]
}
{% endschema %}
