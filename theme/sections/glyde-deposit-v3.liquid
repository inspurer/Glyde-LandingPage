          <article class="glyde-deposit-v3__feature-card"><span class="glyde-deposit-v3__feature-icon"><img src="{{ 'glyde-deposit-v3-feature-protection-mobile.svg' | asset_url }}" alt="" width="48" height="48"></span><p>Helps Prevent Over Cutting</p></article>
        </div>
        <div class="glyde-deposit-v3__purchase-area">
          <div class="glyde-deposit-v3__prices" aria-label="Regular price $219; reservation price $169">
            <div class="glyde-deposit-v3__regular-price"><span>Regular Price</span><strong>$219</strong></div>
            <div class="glyde-deposit-v3__reservation-price"><span>Reservation Price</span><strong>$169</strong></div>
          </div>
          {% if checkout_ready %}
            <a class="glyde-deposit-v3__reserve-button" href="{{ checkout_url | strip | escape }}" data-track="deposit_reserve" data-track-location="deposit_v3_mobile" aria-label="Reserve GLYDE for 5 dollars">
              <img src="{{ 'glyde-deposit-v3-reserve-button-mobile.svg' | asset_url }}" alt="" width="625" height="150"><span>Reserve for $5</span>
            </a>
          {% else %}
            <span class="glyde-deposit-v3__reserve-button" role="status" aria-disabled="true"><img src="{{ 'glyde-deposit-v3-reserve-button-mobile.svg' | asset_url }}" alt="" width="625" height="150"><span>Reservation unavailable</span></span>
          {% endif %}
        </div>
      </section>

      <section class="glyde-deposit-v3__mobile-testimonials" aria-labelledby="deposit-v3-testimonials-mobile">
        <p class="glyde-deposit-v3__section-eyebrow">What Users Say</p>
        <h2 id="deposit-v3-testimonials-mobile">See Why Customers<br><span>Love GLYDE.</span></h2>
        <div class="glyde-deposit-v3__testimonial-viewport">
          <div class="glyde-deposit-v3__testimonial-rail">
            <article class="glyde-deposit-v3__testimonial-card">
              <div class="glyde-deposit-v3__stars" aria-label="5 out of 5 stars">{% for star in (1..5) %}<img src="{{ 'glyde-deposit-v3-star.svg' | asset_url }}" alt="" width="20" height="20">{% endfor %}</div>
              <blockquote>"It has saved me much time and money, and is the reason why I have been able to have a good haircut while being a first time father!"</blockquote>
              <div class="glyde-deposit-v3__testimonial-person"><img src="{{ 'glyde-deposit-v3-avatar-andreas-mobile.png' | asset_url }}" alt="" width="48" height="48"><div><strong>Andreas M.</strong><span>Sweden | 1-3 cuts a month</span></div></div>
            </article>
            <article class="glyde-deposit-v3__testimonial-card">
              <div class="glyde-deposit-v3__stars" aria-label="5 out of 5 stars">{% for star in (1..5) %}<img src="{{ 'glyde-deposit-v3-star.svg' | asset_url }}" alt="" width="20" height="20">{% endfor %}</div>
              <blockquote>"I love that it's easy for me to do on my own, at home and that it saves me money and time. I don't plan on going back to a barber any time soon."</blockquote>
              <div class="glyde-deposit-v3__testimonial-person"><img src="{{ 'glyde-deposit-v3-avatar-cory-mobile.png' | asset_url }}" alt="" width="48" height="48"><div><strong>Cory M.</strong><span>USA | Multiple self-cuts</span></div></div>
            </article>
            <article class="glyde-deposit-v3__testimonial-card">
              <div class="glyde-deposit-v3__stars" aria-label="4 out of 5 stars">
                {% for star in (1..5) %}
                  {% if star <= 4 %}
                    <img src="{{ 'glyde-deposit-v3-star.svg' | asset_url }}" alt="" width="20" height="20">
                  {% else %}
                    <img src="{{ 'glyde-deposit-v3-star-highlight.svg' | asset_url }}" alt="" width="20" height="20">
                  {% endif %}
                {% endfor %}
              </div>
              <blockquote>"<span class="glyde-deposit-v3__testimonial-initial">I</span>t has saved me much time and money, and is the reason why I have been able to have a good haircut while being a first time father!"</blockquote>
              <div class="glyde-deposit-v3__testimonial-person"><img src="{{ 'glyde-deposit-v3-avatar-paolo-mobile.png' | asset_url }}" alt="" width="48" height="48"><div><strong>Paolo P.</strong><span>Italy | 20 years of home cutting</span></div></div>
            </article>
          </div>
        </div>
      </section>

      <section class="glyde-deposit-v3__mobile-faq" aria-labelledby="deposit-v3-faq-mobile">
        <p class="glyde-deposit-v3__section-eyebrow">FAQ</p>
        <h2 id="deposit-v3-faq-mobile">Questions You Might<br>Have.</h2>
        <div class="glyde-deposit-v3__faq-list" data-glyde-deposit-faq>
          {% for faq_number in (1..7) %}
            {%- liquid
              case faq_number
                when 1
                  assign faq_question = faq_1_question
                  assign faq_answer = faq_1_answer
                when 2
                  assign faq_question = faq_2_question
                  assign faq_answer = faq_2_answer
                when 3
                  assign faq_question = faq_3_question
                  assign faq_answer = faq_3_answer
                when 4
                  assign faq_question = faq_4_question
                  assign faq_answer = faq_4_answer
                when 5
                  assign faq_question = faq_5_question
                  assign faq_answer = faq_5_answer
                when 6
                  assign faq_question = faq_6_question
                  assign faq_answer = faq_6_answer
                when 7
                  assign faq_question = faq_7_question
                  assign faq_answer = faq_7_answer
              endcase
              assign answer_id = 'deposit-v3-mobile-answer-' | append: section.id | append: '-' | append: faq_number
            -%}
            <section class="glyde-deposit-v3__faq-item" data-faq-item>
              <h3><button type="button" data-faq-trigger aria-expanded="false" aria-controls="{{ answer_id }}"><span>{{ faq_question }}</span><span class="glyde-deposit-v3__faq-chevron" aria-hidden="true"></span></button></h3>
              <div class="glyde-deposit-v3__faq-answer" id="{{ answer_id }}" data-faq-answer aria-hidden="true"><p>{{ faq_answer }}</p></div>
            </section>
          {% endfor %}
        </div>
      </section>

      <footer class="glyde-deposit-v3__mobile-footer">
        <nav aria-label="Legal and support links">
          <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy Policy</a>
          <a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}">Terms Of Service</a>
          <a href="mailto:timchen@smarthairclipper.com">Contact</a>
        </nav>
        <p>© 2026 GLYDE By Kuaiku Innovation. All Rights Reserved.</p>
      </footer>
    </div>
  </div>
</div>

{% if deposit_product != blank %}
  <script type="application/ld+json">{{ deposit_product | structured_data }}</script>
{% endif %}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {"@type":"Question","name":{{ faq_1_question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ faq_1_answer | json }}}},
      {"@type":"Question","name":{{ faq_2_question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ faq_2_answer | json }}}},
      {"@type":"Question","name":{{ faq_3_question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ faq_3_answer | json }}}},
      {"@type":"Question","name":{{ faq_4_question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ faq_4_answer | json }}}},
      {"@type":"Question","name":{{ faq_5_question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ faq_5_answer | json }}}},
      {"@type":"Question","name":{{ faq_6_question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ faq_6_answer | json }}}},
      {"@type":"Question","name":{{ faq_7_question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ faq_7_answer | json }}}}
    ]
  }
</script>

