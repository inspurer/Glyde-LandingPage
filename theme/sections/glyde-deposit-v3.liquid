{%- liquid
  assign deposit_product_handle = 'glyde-vip-prelaunch-reservation-online'
  assign expected_variant_id = '53870139375899'
  assign deposit_product = all_products[deposit_product_handle]
  assign deposit_variant = blank

  if deposit_product != blank and deposit_product.handle == deposit_product_handle
    for candidate_variant in deposit_product.variants
      assign candidate_variant_id = candidate_variant.id | append: ''
      if candidate_variant_id == expected_variant_id
        assign deposit_variant = candidate_variant
        break
      endif
    endfor
  endif

  assign checkout_ready = false
  if deposit_variant != blank and deposit_variant.available and deposit_variant.price == 500
    assign checkout_ready = true
  endif

  capture checkout_url
    echo routes.cart_url
    echo '/'
    echo expected_variant_id
    echo ':1?attributes%5Bglyde_source%5D=glydeclipper.com&attributes%5Bglyde_offer%5D=GLYDE-VIP-PRELAUNCH-DEPOSIT-5&attributes%5Bcheckout_version%5D=shopify-theme-v3&ref=glydeclipper-com'
  endcapture

  assign faq_1_question = 'Is GLYDE beginner-friendly?'
  assign faq_1_answer = 'Yes. GLYDE is designed for people with little or no haircutting experience. Simply choose a hairstyle in the app and follow the step-by-step visual and audio guidance. As you cut, GLYDE automatically adjusts the blade to help you achieve a smooth, even result.'
  assign faq_2_question = 'How does GLYDE create an automatic fade?'
  assign faq_2_answer = 'Built-in sensors track the clipper’s movement distance, speed, tilt, and angle in real time. GLYDE then automatically adjusts the cutting length as you move. The fade-band marks where the fade should begin, helping create a smooth and consistent transition between lengths.'
  assign faq_3_question = 'Can I use GLYDE to cut my own hair?'
  assign faq_3_answer = 'Yes. GLYDE is designed to make self-haircuts easier with step-by-step guidance in the app. If it’s your first time, we recommend starting with a simple style, taking your time, and using a mirror for areas that are harder to see.'
  assign faq_4_question = 'What hairstyles and hair types does GLYDE support?'
  assign faq_4_answer = 'GLYDE is designed primarily for short hairstyles, including buzz cuts, crew cuts, side parts, fades, tapers, and side-and-back touch-ups. It is not currently designed for long hairstyles, very curly hair, or skin fades.'
  assign faq_5_question = 'How does GLYDE help prevent mistakes?'
  assign faq_5_answer = 'GLYDE continuously monitors how you move and holds the clipper. If you move too quickly or use an incorrect angle, it can adjust the cutting length and provide guidance to help reduce harsh lines, uneven transitions, and accidental overcutting. For the best results, follow the app and move slowly and steadily.'
  assign faq_6_question = 'Does the GLYDE app work offline?'
  assign faq_6_answer = 'Yes. Once you’ve completed the initial setup and downloaded your chosen hairstyle, you can follow the guidance without Wi-Fi or mobile data. You’ll still need an internet connection to download new styles, sync content, and install updates.'
  assign faq_7_question = 'How long does the battery last, and how do I clean GLYDE?'
  assign faq_7_answer = 'GLYDE has a 2600mAh battery and provides approximately two hours of runtime on a full charge. It charges via USB-C. GLYDE is not waterproof, so do not rinse or submerge it in water. After each use, clean the blade with the included brush and apply lubricating oil as needed.'
-%}

