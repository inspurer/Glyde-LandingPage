<div id="top" class="page" data-glyde-landing>
  <section class="hero" aria-labelledby="hero-title">
    <img
      class="heroPhoto"
      src="{{ 'hero-photo.png' | asset_url }}"
      alt="A man using the GLYDE smart auto-fade clipper at home"
      width="2048"
      height="1152"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      style="position:absolute;color:transparent"
    >
    <div class="heroShade"></div>
    <img
      class="heroCorners"
      src="{{ 'hero-corners.svg' | asset_url }}"
      alt=""
      width="3074"
      height="2088"
      loading="eager"
      fetchpriority="high"
      aria-hidden="true"
      style="position:absolute;color:transparent"
    >

    <header class="heroHeader">
      <a href="#top" aria-label="GLYDE home" class="logoLink">
        <img src="{{ 'logo.png' | asset_url }}" width="198" height="140" alt="GLYDE" loading="eager">
      </a>
      <a class="reserveButton" href="/pages/deposit">Reserve for $3</a>
    </header>

    <h1 id="hero-title" class="heroTitle">
      <span>Your first</span>
      <strong>perfect fade</strong>
      <span>at home</span>
    </h1>

    <div class="heroProductNote">
      <span>/01</span>
      <p>World's First Smart Auto-Fade Clipper</p>
    </div>

    <div class="heroFormArea">
      <div class="formShell heroFormShell">
        {% assign hero_form_success = false %}
        {% assign hero_form_has_errors = false %}
        {% form 'customer', id: 'glyde-hero-waitlist', class: 'waitlistForm', return_to: '/#glyde-hero-waitlist', data-shopify-captcha: 'true' %}
          {% if form.posted_successfully? %}
            {% assign hero_form_success = true %}
          {% endif %}
          {% if form.errors %}
            {% assign hero_form_has_errors = true %}
          {% endif %}
          <input type="hidden" name="contact[tags]" value="newsletter,GLYDE Landing Page">
          <label class="srOnly" for="hero-email">Email address</label>
          <input
            id="hero-email"
            name="contact[email]"
            type="email"
            inputmode="email"
            autocomplete="email"
            placeholder="GLYDE@163.com"
            value="{{ form.email | escape }}"
            required
            aria-invalid="{% if form.errors %}true{% else %}false{% endif %}"
            aria-describedby="hero-form-status"
          >
          <span aria-hidden="true" class="formDivider"></span>
          <button type="submit">Get Early Access</button>
        {% endform %}
        <p
          id="hero-form-status"
          class="formStatus{% if hero_form_has_errors %} formError{% endif %}"
          aria-live="polite"
        >
          {% if hero_form_success %}
            You're on the list. Watch your inbox for GLYDE updates.
          {% elsif hero_form_has_errors %}
            Please enter a valid email address and try again.
          {% endif %}
        </p>
      </div>
      <p class="heroFormCaption">Join the waitlist. Save $80 when we launch.</p>
    </div>

    <p class="heroIntro">
      The first clipper with auto-fade technology. Guided cuts, consistent results, zero skill needed.
    </p>

    <ul class="heroTrust" aria-label="Reservation benefits">
      <li>Secure checkout</li>
      <li>Early backer pricing</li>
      <li>Priority support</li>
    </ul>

    <div class="mediaReports">
      <p>Relevant Media Reports</p>
      <div>
        <span>CNET</span>
        <a href="https://www.theverge.com/tech/854436/would-you-let-ai-cut-your-hair" target="_blank" rel="noreferrer">The Verge</a>
        <a href="https://www.foxnews.com/tech/ces-2026-showstoppers-10-gadgets-you-have-see" target="_blank" rel="noreferrer">Fox News</a>
        <a href="https://www.zdnet.com/article/best-weird-tech-ces-2026/" target="_blank" rel="noreferrer">ZDNet</a>
      </div>
    </div>
  </section>

