  <section class="section manual" aria-labelledby="manual-title">
    <h2 id="manual-title">Manual<br>Mode</h2>
    <p class="manualCopy"><strong>Any Length. Zero Attachments.</strong> Every Detail Designed Around Your Daily Routine.</p>
    <div class="manualDevice">
      <img
        src="{{ 'body-image-1.png' | asset_url }}"
        alt="GLYDE clipper with adjustable blade"
        width="1132"
        height="1315"
        loading="lazy"
        decoding="async"
        style="position:absolute;color:transparent"
      >
    </div>
    <div class="lengthScale" data-glyde-length-picker>
      <div
        class="lengthScaleViewport"
        data-glyde-length-picker-viewport
        role="listbox"
        tabindex="0"
        aria-label="Blade length in inches"
        aria-describedby="length-picker-help-{{ section.id }}"
        aria-activedescendant="length-option-{{ section.id }}-3"
      >
        <div class="lengthScaleTrack" data-glyde-length-picker-track>
          <div class="lengthScaleOption" id="length-option-{{ section.id }}-0" data-glyde-length-option data-index="0" data-value="0.2" role="option" aria-selected="false">0.2</div>
          <div class="lengthScaleOption" id="length-option-{{ section.id }}-1" data-glyde-length-option data-index="1" data-value="0.3" role="option" aria-selected="false">0.3</div>
          <div class="lengthScaleOption" id="length-option-{{ section.id }}-2" data-glyde-length-option data-index="2" data-value="0.4" role="option" aria-selected="false">0.4</div>
          <div class="lengthScaleOption is-selected" id="length-option-{{ section.id }}-3" data-glyde-length-option data-index="3" data-value="0.5" role="option" aria-selected="true">0.5</div>
          <div class="lengthScaleOption" id="length-option-{{ section.id }}-4" data-glyde-length-option data-index="4" data-value="0.6" role="option" aria-selected="false">0.6</div>
          <div class="lengthScaleOption" id="length-option-{{ section.id }}-5" data-glyde-length-option data-index="5" data-value="0.7" role="option" aria-selected="false">0.7</div>
          <div class="lengthScaleOption" id="length-option-{{ section.id }}-6" data-glyde-length-option data-index="6" data-value="0.8" role="option" aria-selected="false">0.8</div>
        </div>
        <strong class="lengthScaleUnit" aria-hidden="true">Inch</strong>
      </div>
      <p id="length-picker-help-{{ section.id }}" class="srOnly">Swipe or drag vertically, scroll, or use the arrow keys to choose a blade length.</p>
      <output class="srOnly" data-glyde-length-picker-output aria-live="polite">0.5 inches</output>
    </div>
  </section>

