# Shopify store hostname only; do not include https:// or a path.
SHOPIFY_STORE_DOMAIN=drhrvj-70.myshopify.com

# Shopify Admin GraphQL stable API version.
SHOPIFY_API_VERSION=2026-07

# Required in production. The API never reports success unless Shopify confirms
# the customer upsert, newsletter tag, and email-marketing consent update.
# Requires the write_customers access scope and protected customer data access.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Checkout routing for glydeclipper.online only. It is fail-closed: explicitly
# set "paypal" for the legacy flow, or set "shopify" only after the new $5
# product has been verified. Never use the existing .com reservation variant.
CHECKOUT_PROVIDER=disabled
SHOPIFY_CHECKOUT_STORE_DOMAIN=drhrvj-70.myshopify.com
SHOPIFY_DEPOSIT_VARIANT_ID=

# Required to open /admin. At least 16 characters; the admin page refuses to
# sign anyone in with a shorter one rather than pretend to be protected.
# Generate with: openssl rand -base64 32
ADMIN_TOKEN=

# PayPal REST app. Keep sandbox until an end-to-end sandbox payment, cancel,
# failure and webhook replay have all been verified. Use "production" only
# with the matching live credentials.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Required before production checkout is enabled. Create the webhook for:
# https://glydeclipper.online/api/paypal/webhook
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=

# Operational switch. Production requires an explicit true; false pauses any
# environment while in-flight capture and webhook processing stays live.
PAYPAL_ACCEPT_NEW_ORDERS=false

# Fixed public origin used for PayPal return/cancel URLs and POST origin checks.
CHECKOUT_ORIGIN=https://glydeclipper.online

# Directory holding the waitlist SQLite database. Defaults to /data in
# production (a mounted volume) and .data in development.
GLYDE_DATA_DIR=
