# Shopify store hostname only; do not include https:// or a path.
SHOPIFY_STORE_DOMAIN=drhrvj-70.myshopify.com

# Shopify Admin GraphQL stable API version.
SHOPIFY_API_VERSION=2026-07

# Required in production. The API never reports success unless Shopify confirms
# the customer upsert, newsletter tag, and email-marketing consent update.
# Requires the write_customers access scope and protected customer data access.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Required to open /admin. At least 16 characters; the admin page refuses to
# sign anyone in with a shorter one rather than pretend to be protected.
# Generate with: openssl rand -base64 32
ADMIN_TOKEN=

# Directory holding the waitlist SQLite database. Defaults to /data in
# production (a mounted volume) and .data in development.
GLYDE_DATA_DIR=
